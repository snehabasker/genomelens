# Optional: enables the cloud model. Without it the AI step uses a local model (Ollama) or, failing that,
# a no-model summary compiled from the database records.
ANTHROPIC_API_KEY=sk-ant-...

# Models (defaults shown)
# SYNTH_MODEL=claude-opus-5-5
# SYNTH_EFFORT=low
# JUDGE_MODEL=claude-haiku-5-5
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# Raises NCBI's rate limit from 3 to 10 requests/second (https://www.ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=

# Public-demo protection
# DAILY_BUDGET_USD=2.00        # hard cap on model spend per day; degrades gracefully when reached
# RATE_LIMIT_RUNS=10           # analyses per IP per window
# RATE_LIMIT_WINDOW_S=600
# RUN_TIMEOUT_S=120
